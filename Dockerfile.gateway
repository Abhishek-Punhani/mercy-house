FROM python:3.12.8-slim@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
ARG RUN_UID=1000
RUN useradd --uid ${RUN_UID} --create-home gateway
WORKDIR /app
COPY mercy/town/api_gateway.py mercy/town/providers.py /app/
USER gateway
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "/app/api_gateway.py"]
